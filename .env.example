# Copy this file to .env and fill in real values before running
# docker compose -f docker-compose.prod.yml up -d --build
# .env is gitignored -- never commit real secrets.

# MySQL
DB_NAME=meal_planner
DB_USERNAME=meal_planner
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# App login (HTTP Basic) -- this is the username/password you'll be prompted for in the browser
APP_USERNAME=admin
APP_PASSWORD=changeme

# Host port the app is reachable on, e.g. http://<media-server>:8080
APP_PORT=8080
